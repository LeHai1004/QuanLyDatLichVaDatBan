            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.customer.RestaurantDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.booking.BookingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.customer.booking.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.booking.BookingConfirmActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.booking.BookingQRActivity"
            android:exported="false" />
        <activity
            android:name=".ui.owner.OwnerBookingDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.owner.OwnerPreOrderActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.booking.QRScanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.customer.booking.CheckInSuccessActivity"
            android:exported="false" />
        <activity
