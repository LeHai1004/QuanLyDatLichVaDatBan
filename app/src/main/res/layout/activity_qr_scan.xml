<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llQrScanRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream"
    android:orientation="vertical">

    <!-- Thanh tiêu đề (Top bar) -->
    <RelativeLayout
        android:id="@+id/rlTopBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/booking_back_btn_size"
            android:layout_height="@dimen/booking_back_btn_size"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_booking_back_btn"
            android:contentDescription="@string/cd_back_button"
            android:src="@drawable/ic_auth_back" />

        <!-- Biểu trưng BookTable ở giữa -->
        <LinearLayout
            android:id="@+id/llBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_booking_btn_primary">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_brand_utensils" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvBrandName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/app_name"
                android:textColor="@color/booktable_dark"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNotification"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_booking_back_btn"
            android:contentDescription="@string/owner_action_notifications_title"
            android:src="@drawable/ic_auth_bell" />
    </RelativeLayout>

    <ScrollView
        android:id="@+id/svContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <!-- Tiêu đề lớn -->
            <TextView
                android:id="@+id/tvScanTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/qr_scan_title"
                android:textColor="@color/booktable_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitleBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/qr_scan_subtitle_bold"
                android:textColor="@color/booktable_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitleRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/qr_scan_subtitle_regular"
                android:textColor="@color/booktable_muted"
                android:textSize="12sp" />

            <!-- Khung camera preview -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvCameraContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qr_scan_camera_height"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/qr_camera_bg"
                app:cardCornerRadius="@dimen/qr_scan_camera_radius"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Live Camera Preview -->
                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Badge "SẴN SÀNG QUÉT" -->
                    <TextView
                        android:id="@+id/tvReadyBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_qr_scan_badge"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:letterSpacing="0.05"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:text="@string/qr_scan_ready_badge"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Vùng quét vuông 240 x 240 dp -->
                    <FrameLayout
                        android:id="@+id/flScanBox"
                        android:layout_width="@dimen/qr_scan_box_size"
                        android:layout_height="@dimen/qr_scan_box_size"
                        android:layout_gravity="center">

                        <!-- 4 góc viền màu cam #E8622C -->
                        <!-- Góc Trên - Trái -->
                        <View
                            android:layout_width="@dimen/qr_scan_corner_length"
                            android:layout_height="@dimen/qr_scan_corner_thickness"
                            android:layout_gravity="top|start"
                            android:background="@color/qr_corner_line" />

                        <View
                            android:layout_width="@dimen/qr_scan_corner_thickness"
                            android:layout_height="@dimen/qr_scan_corner_length"
                            android:layout_gravity="top|start"
                            android:background="@color/qr_corner_line" />

                        <!-- Góc Trên - Phải -->
                        <View
                            android:layout_width="@dimen/qr_scan_corner_length"
                            android:layout_height="@dimen/qr_scan_corner_thickness"
                            android:layout_gravity="top|end"
                            android:background="@color/qr_corner_line" />

                        <View
                            android:layout_width="@dimen/qr_scan_corner_thickness"
                            android:layout_height="@dimen/qr_scan_corner_length"
                            android:layout_gravity="top|end"
                            android:background="@color/qr_corner_line" />

                        <!-- Góc Dưới - Trái -->
                        <View
                            android:layout_width="@dimen/qr_scan_corner_length"
                            android:layout_height="@dimen/qr_scan_corner_thickness"
                            android:layout_gravity="bottom|start"
                            android:background="@color/qr_corner_line" />

                        <View
                            android:layout_width="@dimen/qr_scan_corner_thickness"
                            android:layout_height="@dimen/qr_scan_corner_length"
                            android:layout_gravity="bottom|start"
                            android:background="@color/qr_corner_line" />

                        <!-- Góc Dưới - Phải -->
                        <View
                            android:layout_width="@dimen/qr_scan_corner_length"
                            android:layout_height="@dimen/qr_scan_corner_thickness"
                            android:layout_gravity="bottom|end"
                            android:background="@color/qr_corner_line" />

                        <View
                            android:layout_width="@dimen/qr_scan_corner_thickness"
                            android:layout_height="@dimen/qr_scan_corner_length"
                            android:layout_gravity="bottom|end"
                            android:background="@color/qr_corner_line" />

                        <!-- Vạch quét laser giữa -->
                        <View
                            android:id="@+id/vScanLaser"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_gravity="center"
                            android:background="@color/qr_laser_line" />
                    </FrameLayout>

                    <!-- Hướng dẫn dưới đáy khung camera -->
                    <TextView
                        android:id="@+id/tvHoldSteady"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="24dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/qr_scan_hold_steady"
                        android:textColor="@color/white"
                        android:textSize="11sp" />

                    <!-- Loading Indicator khi đang xác thực QR -->
                    <ProgressBar
                        android:id="@+id/pbScanning"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/booktable_orange"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card thông tin mã bàn / mã vị trí -->
            <LinearLayout
                android:id="@+id/llInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_qr_scan_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvInfoTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/qr_scan_info_card_title"
                    android:textColor="@color/booktable_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfoDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/qr_scan_info_card_desc"
                    android:textColor="@color/booktable_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Thao tác cuối màn hình (Bottom action) -->
    <LinearLayout
        android:id="@+id/llBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_booking_btn_primary"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/qr_scan_btn_manual"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/booktable_orange"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/tvFooterNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:text="@string/qr_scan_footer_note"
            android:textColor="@color/booktable_muted"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
