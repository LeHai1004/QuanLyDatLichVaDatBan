<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRestaurant"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/restaurant_card_margin_bottom"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/booktable_surface"
    app:cardCornerRadius="@dimen/restaurant_card_radius"
    app:cardElevation="@dimen/restaurant_card_elevation"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/restaurant_card_image_height">

            <ImageView
                android:id="@+id/ivRestaurantImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_image_rounded"
                android:contentDescription="@string/app_name"
                android:padding="@dimen/splash_gap_large"
                android:scaleType="centerInside"
                android:src="@drawable/ic_restaurant_placeholder" />

            <TextView
                android:id="@+id/tvRestaurantStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/nav_bottom_padding"
                android:background="@drawable/bg_status_badge_open"
                android:fontFamily="@font/be_vietnam_pro"
                android:paddingHorizontal="@dimen/detail_status_padding_h"
                android:paddingVertical="@dimen/detail_status_padding_v"
                android:textColor="@color/auth_success"
                android:textSize="@dimen/detail_status_text_size"
                android:textStyle="bold"
                tools:text="@string/restaurant_status_open" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/restaurant_card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRestaurantName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:maxLines="1"
                    android:textColor="@color/booktable_dark"
                    android:textSize="@dimen/restaurant_card_name_size"
                    android:textStyle="bold"
                    tools:text="Bếp Nhà · Thảo Điền" />

                <TextView
                    android:id="@+id/tvRestaurantCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/restaurant_card_gap"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/booktable_orange"
                    android:textSize="@dimen/restaurant_card_desc_size"
                    android:textStyle="bold"
                    tools:text="Món Việt" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/restaurant_card_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivRatingIcon"
                    android:layout_width="@dimen/restaurant_card_icon_size"
                    android:layout_height="@dimen/restaurant_card_icon_size"
                    android:contentDescription="@string/search_rating_label"
                    android:src="@drawable/ic_star" />

                <TextView
                    android:id="@+id/tvRestaurantRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/auth_brand_inset"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/booktable_dark"
                    android:textSize="@dimen/restaurant_card_meta_size"
                    android:textStyle="bold"
                    tools:text="4.7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/restaurant_card_gap"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="•"
                    android:textColor="@color/booktable_muted"
                    android:textSize="@dimen/restaurant_card_meta_size" />

                <ImageView
                    android:id="@+id/ivClockIcon"
                    android:layout_width="@dimen/restaurant_card_icon_size"
                    android:layout_height="@dimen/restaurant_card_icon_size"
                    android:contentDescription="@string/detail_hours_label"
                    android:src="@drawable/ic_clock" />

                <TextView
                    android:id="@+id/tvRestaurantHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/auth_brand_inset"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/booktable_muted"
                    android:textSize="@dimen/restaurant_card_meta_size"
                    tools:text="09:00 - 22:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/restaurant_card_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivAddressIcon"
                    android:layout_width="@dimen/restaurant_card_icon_size"
                    android:layout_height="@dimen/restaurant_card_icon_size"
                    android:contentDescription="@string/detail_address_label"
                    android:src="@drawable/ic_location_pin" />

                <TextView
                    android:id="@+id/tvRestaurantAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/auth_brand_inset"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:maxLines="1"
                    android:textColor="@color/booktable_muted"
                    android:textSize="@dimen/restaurant_card_meta_size"
                    tools:text="12 Nguyễn Văn Hưởng, TP. Hồ Chí Minh" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRestaurantDeposit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/restaurant_card_gap"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_orange"
                android:textSize="@dimen/restaurant_card_meta_size"
                android:textStyle="bold"
                tools:text="Cọc: 100.000đ" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
