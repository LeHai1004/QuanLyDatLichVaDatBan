<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/notification_card_margin_bottom"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/booktable_surface"
    app:cardCornerRadius="@dimen/notification_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="@dimen/notification_card_padding">

        <!-- Type Icon -->
        <FrameLayout
            android:id="@+id/flIconContainer"
            android:layout_width="@dimen/notification_icon_size"
            android:layout_height="@dimen/notification_icon_size"
            android:background="@drawable/bg_notification_item_read">

            <ImageView
                android:id="@+id/ivNotificationIcon"
                android:layout_width="@dimen/notification_icon_inner_size"
                android:layout_height="@dimen/notification_icon_inner_size"
                android:layout_gravity="center"
                android:contentDescription="@string/owner_notification_title"
                android:src="@drawable/ic_notification_booking" />
        </FrameLayout>

        <!-- Notification Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/notification_header_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotificationTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:maxLines="1"
                    android:textColor="@color/booktable_dark"
                    android:textSize="@dimen/notification_item_title_size"
                    android:textStyle="bold"
                    tools:text="Đơn đặt bàn mới #BK101" />

                <!-- Unread Indicator Dot -->
                <View
                    android:id="@+id/vUnreadDot"
                    android:layout_width="@dimen/notification_dot_size"
                    android:layout_height="@dimen/notification_dot_size"
                    android:layout_marginStart="@dimen/notification_dot_margin"
                    android:background="@drawable/bg_notification_unread_dot"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotificationBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/booktable_dark"
                android:textSize="@dimen/notification_item_body_size"
                tools:text="Khách hàng Nguyễn Văn An vừa đặt bàn 4 người vào 19:00 hôm nay." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/notification_header_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotificationType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_notification_tag"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:paddingHorizontal="@dimen/notification_tag_padding_h"
                    android:paddingVertical="@dimen/notification_tag_padding_v"
                    android:textColor="@color/booktable_muted"
                    android:textSize="@dimen/notification_item_tag_size"
                    android:textStyle="bold"
                    tools:text="Đơn mới" />

                <TextView
                    android:id="@+id/tvNotificationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/notification_header_gap"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/booktable_muted"
                    android:textSize="@dimen/notification_item_time_size"
                    tools:text="10 phút trước" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
