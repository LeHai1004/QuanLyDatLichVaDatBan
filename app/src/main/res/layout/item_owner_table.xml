<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/owner_table_card_radius"
    app:cardElevation="2dp"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:id="@+id/llTableContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top row: Type Tag & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/llTypeTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_owner_table_tag_room"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivTypeIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_owner_table_normal"
                    app:tint="@color/owner_table_room_tag_text" />

                <TextView
                    android:id="@+id/tvTypeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/owner_table_room_tag_text"
                    android:textSize="11sp"
                    tools:text="Bàn" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Status badge -->
            <TextView
                android:id="@+id/tvTableStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_history_status_completed"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/owner_table_available"
                android:textSize="11sp"
                tools:text="Trống" />
        </LinearLayout>

        <!-- Name & Capacity -->
        <TextView
            android:id="@+id/tvTableName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="@color/booktable_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Bàn T1-04" />

        <TextView
            android:id="@+id/tvCapacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/booktable_muted"
            android:textSize="12sp"
            tools:text="4 người" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/booktable_border" />

        <!-- Booking note or Map coordinates -->
        <TextView
            android:id="@+id/tvSubInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/booktable_muted"
            android:textSize="11sp"
            tools:text="mapX: 120 · mapY: 85" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
