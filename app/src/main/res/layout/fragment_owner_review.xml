<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_booking_back_btn"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_auth_back"
            app:tint="@color/booktable_dark" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:text="@string/owner_review_title"
            android:textColor="@color/booktable_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Card Overview: Điểm trung bình và tổng số đánh giá -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRatingOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/booktable_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/owner_review_average_rating_title"
                        android:textColor="@color/booktable_muted"
                        android:textSize="13sp" />

                    <!-- Average Score: 4.8 / 5.0 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAverageRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:textColor="@color/booktable_dark"
                            android:textSize="40sp"
                            android:textStyle="bold"
                            tools:text="4.8" />

                        <TextView
                            android:id="@+id/tvRatingScale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:text="/ 5.0"
                            android:textColor="@color/booktable_muted"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 5 Average Stars Visual -->
                    <LinearLayout
                        android:id="@+id/llAverageStars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivAvgStar1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:id="@+id/ivAvgStar2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:id="@+id/ivAvgStar3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:id="@+id/ivAvgStar4"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star" />

                        <ImageView
                            android:id="@+id/ivAvgStar5"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_outline" />
                    </LinearLayout>

                    <!-- Based on X reviews -->
                    <TextView
                        android:id="@+id/tvTotalReviews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/booktable_muted"
                        android:textSize="13sp"
                        tools:text="Dựa trên 24 lượt đánh giá" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Star Filter Chips ScrollView -->
            <HorizontalScrollView
                android:id="@+id/hsvStarFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llStarFilterChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/owner_chip_height"
                        android:background="@drawable/bg_owner_chip"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/owner_chip_padding_h"
                        android:text="Tất cả (0)"
                        android:textColor="@color/color_owner_chip_text"
                        android:textSize="@dimen/owner_chip_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFilter5Star"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/owner_chip_height"
                        android:layout_marginStart="@dimen/owner_chip_gap"
                        android:background="@drawable/bg_owner_chip"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/owner_chip_padding_h"
                        android:text="5 sao (0)"
                        android:textColor="@color/color_owner_chip_text"
                        android:textSize="@dimen/owner_chip_text_size" />

                    <TextView
                        android:id="@+id/tvFilter4Star"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/owner_chip_height"
                        android:layout_marginStart="@dimen/owner_chip_gap"
                        android:background="@drawable/bg_owner_chip"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/owner_chip_padding_h"
                        android:text="4 sao (0)"
                        android:textColor="@color/color_owner_chip_text"
                        android:textSize="@dimen/owner_chip_text_size" />

                    <TextView
                        android:id="@+id/tvFilter3Star"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/owner_chip_height"
                        android:layout_marginStart="@dimen/owner_chip_gap"
                        android:background="@drawable/bg_owner_chip"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/owner_chip_padding_h"
                        android:text="3 sao (0)"
                        android:textColor="@color/color_owner_chip_text"
                        android:textSize="@dimen/owner_chip_text_size" />

                    <TextView
                        android:id="@+id/tvFilter2Star"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/owner_chip_height"
                        android:layout_marginStart="@dimen/owner_chip_gap"
                        android:background="@drawable/bg_owner_chip"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/owner_chip_padding_h"
                        android:text="2 sao (0)"
                        android:textColor="@color/color_owner_chip_text"
                        android:textSize="@dimen/owner_chip_text_size" />

                    <TextView
                        android:id="@+id/tvFilter1Star"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/owner_chip_height"
                        android:layout_marginStart="@dimen/owner_chip_gap"
                        android:background="@drawable/bg_owner_chip"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/owner_chip_padding_h"
                        android:text="1 sao (0)"
                        android:textColor="@color/color_owner_chip_text"
                        android:textSize="@dimen/owner_chip_text_size" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Loading State -->
            <LinearLayout
                android:id="@+id/llLoadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/booktable_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/state_loading"
                    android:textColor="@color/booktable_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Error State -->
            <LinearLayout
                android:id="@+id/llErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/owner_review_error_load"
                    android:textColor="@color/booktable_error"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/owner_chip_height"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/owner_review_btn_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/booktable_orange"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/llEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivEmptyIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_empty_reviews" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/owner_review_empty_title"
                    android:textColor="@color/booktable_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:gravity="center"
                    android:text="@string/owner_review_empty_message"
                    android:textColor="@color/booktable_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Reviews List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_review" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
