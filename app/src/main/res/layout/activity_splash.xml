<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/llSplashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/splash_horizontal_padding"
        android:paddingTop="@dimen/splash_top_padding"
        android:paddingBottom="@dimen/splash_bottom_padding">

        <!-- Brand introduction -->
        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="@dimen/splash_logo_size"
            android:layout_height="@dimen/splash_logo_size"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_splash_logo" />

        <TextView
            android:id="@+id/tvSplashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/splash_name_margin_top"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/splash_name"
            android:textColor="@color/booktable_active"
            android:textSize="@dimen/splash_name_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/splash_tagline_margin_top"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/splash_tagline"
            android:textColor="@color/booktable_muted"
            android:textSize="@dimen/splash_tagline_text_size" />

        <!-- Dining inspiration -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvSplashMeal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/splash_meal_card_height"
            android:layout_marginTop="@dimen/splash_meal_margin_top"
            app:cardBackgroundColor="@color/booktable_surface"
            app:cardCornerRadius="@dimen/splash_meal_radius"
            app:cardElevation="@dimen/splash_meal_elevation"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivSplashMeal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/splash_meal"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_splash_meal" />

                <TextView
                    android:id="@+id/tvSplashMealPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="@dimen/splash_prompt_margin"
                    android:layout_marginTop="@dimen/splash_prompt_margin"
                    android:background="@drawable/bg_splash_prompt"
                    android:drawablePadding="@dimen/splash_prompt_icon_padding"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/splash_prompt_padding_horizontal"
                    android:paddingTop="@dimen/splash_prompt_padding_vertical"
                    android:paddingEnd="@dimen/splash_prompt_padding_horizontal"
                    android:paddingBottom="@dimen/splash_prompt_padding_vertical"
                    android:text="@string/splash_meal_prompt"
                    android:textColor="@color/booktable_dark"
                    android:textSize="@dimen/splash_prompt_text_size"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_splash_heart" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvSplashCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/splash_caption_margin_top"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:text="@string/splash_caption"
            android:textColor="@color/booktable_muted"
            android:textSize="@dimen/splash_caption_text_size" />

        <!-- Loading indicator -->
        <LinearLayout
            android:id="@+id/llSplashDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/splash_dots_margin_top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/splash_dot_size"
                android:layout_height="@dimen/splash_dot_size"
                android:background="@drawable/bg_splash_dot_active" />

            <View
                android:layout_width="@dimen/splash_dot_size"
                android:layout_height="@dimen/splash_dot_size"
                android:layout_marginStart="@dimen/splash_dot_spacing"
                android:background="@drawable/bg_splash_dot" />

            <View
                android:layout_width="@dimen/splash_dot_size"
                android:layout_height="@dimen/splash_dot_size"
                android:layout_marginStart="@dimen/splash_dot_spacing"
                android:background="@drawable/bg_splash_dot" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
