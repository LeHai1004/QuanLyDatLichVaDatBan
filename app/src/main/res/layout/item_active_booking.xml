<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardActiveBooking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/restaurant_card_bg"
    app:cardCornerRadius="@dimen/restaurant_card_radius"
    app:cardElevation="2dp"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/booking_restaurant_card_padding">

        <!-- Header: Name + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRestaurantName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro"
                android:maxLines="1"
                android:textColor="@color/booktable_dark"
                android:textSize="@dimen/restaurant_card_name_size"
                android:textStyle="bold"
                tools:text="Bếp Nhà · Thảo Điền" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_status_badge_open"
                android:fontFamily="@font/be_vietnam_pro"
                android:paddingHorizontal="@dimen/detail_status_padding_h"
                android:paddingVertical="@dimen/detail_status_padding_v"
                android:textColor="@color/auth_success"
                android:textSize="@dimen/detail_status_text_size"
                tools:text="Đã xác nhận" />
        </LinearLayout>

        <!-- Booking details: Date, time, guests -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/booking_title"
                android:src="@drawable/ic_clock"
                app:tint="@color/booktable_orange" />

            <TextView
                android:id="@+id/tvDateTimeGuests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_dark"
                android:textSize="@dimen/restaurant_card_meta_size"
                tools:text="Hôm nay, 20/11/2026 · 19:00 · 2 khách" />
        </LinearLayout>

        <!-- Table Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/booking_title"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/booktable_orange" />

            <TextView
                android:id="@+id/tvTableName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_muted"
                android:textSize="@dimen/restaurant_card_meta_size"
                tools:text="Bàn 1 · Tầng 1" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/booktable_border" />

        <!-- Action Buttons Layout -->
        <LinearLayout
            android:id="@+id/llActionsConfirmed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewMap"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/booking_chip_height"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/active_bookings_btn_view_map"
                android:textColor="@color/booktable_orange"
                android:textSize="@dimen/booking_chip_text_size"
                app:cornerRadius="@dimen/booking_chip_radius"
                app:strokeColor="@color/booktable_orange" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckIn"
                android:layout_width="0dp"
                android:layout_height="@dimen/booking_chip_height"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/active_bookings_btn_arrived"
                android:textColor="@color/booktable_surface"
                android:textSize="@dimen/booking_chip_text_size"
                app:backgroundTint="@color/booktable_orange"
                app:cornerRadius="@dimen/booking_chip_radius" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llActionsCheckedIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigateMap"
                android:layout_width="match_parent"
                android:layout_height="@dimen/booking_chip_height"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/active_bookings_btn_navigate"
                android:textColor="@color/booktable_surface"
                android:textSize="@dimen/booking_chip_text_size"
                app:backgroundTint="@color/booking_success_green"
                app:cornerRadius="@dimen/booking_chip_radius" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
