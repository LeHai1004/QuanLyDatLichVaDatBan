<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_customer_default_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPersonName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/booktable_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Người 1 (Chủ bàn)" />

                <TextView
                    android:id="@+id/tvPersonShareAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/booktable_orange"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="125.000 đ" />
            </LinearLayout>

            <!-- Status Badge: Paid (Green) or Unpaid (Waiting) -->
            <LinearLayout
                android:id="@+id/llPaidBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_owner_status_open"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_split_paid" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/split_bill_status_paid"
                    android:textColor="@color/booking_success_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Assigned Dishes summary (when item split mode is active) -->
        <TextView
            android:id="@+id/tvAssignedItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/booktable_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Món: 2x Phở bò, 1x Trà chanh"
            tools:visibility="visible" />

        <!-- Bottom Action: Pay Button + Loading Indicator -->
        <LinearLayout
            android:id="@+id/llPayActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/pbPaying"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="@color/booktable_orange"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPayShare"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/split_bill_btn_pay_share"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/booktable_orange"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
