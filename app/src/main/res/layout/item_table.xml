<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llTableItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_table_available"
    android:gravity="center"
    android:minHeight="80dp"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvTableName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro"
        android:textColor="@color/booktable_dark"
        android:textSize="@dimen/table_item_name_size"
        android:textStyle="bold"
        tools:text="Bàn 1" />

    <TextView
        android:id="@+id/tvTableCapacity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/be_vietnam_pro"
        android:textColor="@color/booktable_muted"
        android:textSize="@dimen/table_item_capacity_size"
        tools:text="4 người" />

</LinearLayout>
