<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="5dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_countdown_badge"
        android:backgroundTint="@color/booktable_cream">

        <TextView
            android:id="@+id/tvDishQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/booktable_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="2×" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDishName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/booktable_dark"
            android:textSize="11sp"
            tools:text="Gỏi cuốn tôm thịt" />

        <TextView
            android:id="@+id/tvDishPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/booktable_muted"
            android:textSize="9sp"
            tools:text="150.000đ" />
    </LinearLayout>

    <!-- Preparation status tag -->
    <LinearLayout
        android:id="@+id/llStatusTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_countdown_badge"
        android:backgroundTint="@color/booktable_cream"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="7dp"
        android:paddingVertical="4dp">

        <View
            android:id="@+id/vStatusDot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_status_dot_done" />

        <TextView
            android:id="@+id/tvStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/owner_stat_serving"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="Xong" />
    </LinearLayout>
</LinearLayout>
