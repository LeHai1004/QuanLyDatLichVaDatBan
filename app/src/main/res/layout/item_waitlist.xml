<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/booktable_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Customer Name / Restaurant Name & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Nguyễn Văn A" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_waitlist_badge_waiting"
                android:fontFamily="@font/be_vietnam_pro"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/waitlist_badge_waiting_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Đang chờ" />
        </LinearLayout>

        <!-- Time & Guests Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/booktable_orange" />

            <TextView
                android:id="@+id/tvDateTimeGuests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_dark"
                android:textSize="13sp"
                tools:text="18:30 · 24/10/2026 · 4 người" />
        </LinearLayout>

        <!-- Phone number Row (for Owner) -->
        <LinearLayout
            android:id="@+id/llPhoneRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_waitlist_phone"
                app:tint="@color/booktable_muted" />

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_muted"
                android:textSize="13sp"
                tools:text="0912 345 678" />
        </LinearLayout>

        <!-- Created At & Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCreatedAt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_muted"
                android:textSize="11sp"
                tools:text="Đăng ký lúc: 14:20 24/10/2026" />

            <!-- Owner Action: Call -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/waitlist_owner_btn_call"
                android:textAllCaps="false"
                android:textColor="@color/booktable_orange"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_waitlist_phone"
                app:iconSize="14dp"
                app:iconTint="@color/booktable_orange"
                app:strokeColor="@color/booktable_orange" />

            <!-- Owner Action: Mark Handled -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkHandled"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/booktable_orange"
                android:fontFamily="@font/be_vietnam_pro"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/waitlist_owner_btn_mark_handled"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_waitlist_done"
                app:iconSize="14dp"
                app:iconTint="@color/white" />

            <!-- Customer Action: Cancel Waitlist -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/waitlist_btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/booktable_error"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/booktable_error"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
