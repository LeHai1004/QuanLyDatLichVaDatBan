<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/payment_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/booking_back_btn_size"
            android:layout_height="@dimen/booking_back_btn_size"
            android:background="@drawable/bg_booking_back_btn"
            android:contentDescription="@string/cd_back_button"
            android:src="@drawable/ic_auth_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/order_tracking_title"
            android:textColor="@color/booktable_dark"
            android:textSize="@dimen/booking_title_size"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Offline Banner -->
    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/owner_stat_waiting_bg"
        android:fontFamily="@font/be_vietnam_pro"
        android:padding="8dp"
        android:text="@string/order_tracking_offline_banner"
        android:textAlignment="center"
        android:textColor="@color/owner_stat_waiting"
        android:textSize="@dimen/auth_label_text_size"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llHeader" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/llBottomBar"
        app:layout_constraintTop_toBottomOf="@id/tvOfflineBanner">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Summary Status Card -->
            <LinearLayout
                android:id="@+id/llStatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_stat_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvProgressTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/order_tracking_service_in_progress"
                    android:textColor="@color/booktable_orange"
                    android:textSize="@dimen/auth_button_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProgressSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/order_tracking_subtitle"
                    android:textColor="@color/booktable_muted"
                    android:textSize="@dimen/auth_label_text_size" />
            </LinearLayout>

            <!-- Section Title -->
            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/order_tracking_section_dishes"
                android:textColor="@color/booktable_dark"
                android:textSize="@dimen/detail_section_title_size"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrderTracking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_order_tracking" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/llBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/booktable_surface"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallStaff"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_button_height"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/order_tracking_btn_call_staff"
            android:textColor="@color/booktable_orange"
            android:textSize="@dimen/auth_button_text_size"
            app:cornerRadius="@dimen/auth_button_radius"
            app:strokeColor="@color/booktable_orange" />
    </LinearLayout>

    <!-- Shared States -->
    <include
        android:id="@+id/layoutStates"
        layout="@layout/layout_shared_states"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
