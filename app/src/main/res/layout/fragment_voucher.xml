<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/payment_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/booking_back_btn_size"
            android:layout_height="@dimen/booking_back_btn_size"
            android:background="@drawable/bg_booking_back_btn"
            android:contentDescription="@string/cd_back_button"
            android:src="@drawable/ic_auth_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/voucher_title"
            android:textColor="@color/booktable_dark"
            android:textSize="@dimen/booking_title_size"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/tvBottomNote"
        app:layout_constraintTop_toBottomOf="@id/llHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="16dp">

            <!-- Code Input Box -->
            <LinearLayout
                android:id="@+id/llInputBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_voucher_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <EditText
                    android:id="@+id/etCode"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/auth_field_height"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:hint="@string/voucher_input_hint"
                    android:inputType="textCapCharacters"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/booktable_dark"
                    android:textColorHint="@color/booktable_muted"
                    android:textSize="@dimen/auth_body_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApply"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/voucher_btn_height"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/voucher_btn_apply"
                    android:textColor="@color/booktable_surface"
                    android:textSize="@dimen/auth_label_text_size"
                    app:backgroundTint="@color/booktable_orange"
                    app:cornerRadius="@dimen/voucher_btn_radius" />
            </LinearLayout>

            <!-- Section Title -->
            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/voucher_section_exclusive"
                android:textColor="@color/booktable_dark"
                android:textSize="@dimen/detail_section_title_size"
                android:textStyle="bold" />

            <!-- RecyclerView list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVouchers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_voucher" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Note -->
    <TextView
        android:id="@+id/tvBottomNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/booktable_surface"
        android:fontFamily="@font/be_vietnam_pro"
        android:padding="12dp"
        android:text="@string/voucher_note_footer"
        android:textColor="@color/booktable_muted"
        android:textSize="@dimen/auth_register_welcome_text_size"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Shared States -->
    <include
        android:id="@+id/layoutStates"
        layout="@layout/layout_shared_states"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
