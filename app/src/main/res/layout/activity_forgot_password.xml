<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forgotPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvForgotPassword"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llForgotActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_screen_large_padding"
            android:paddingTop="@dimen/auth_screen_padding_vertical"
            android:paddingEnd="@dimen/auth_screen_large_padding"
            android:paddingBottom="@dimen/auth_screen_padding_vertical">

            <LinearLayout
                android:id="@+id/llForgotToolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_toolbar_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnForgotBack"
                    android:layout_width="@dimen/auth_toolbar_button_size"
                    android:layout_height="@dimen/auth_toolbar_button_size"
                    android:background="@drawable/bg_auth_white_rounded"
                    android:contentDescription="@string/auth_back_to_login"
                    android:src="@drawable/ic_auth_back"
                    app:tint="@color/booktable_dark" />

                <LinearLayout
                    android:id="@+id/llForgotHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/auth_horizontal_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvForgotBreadcrumb"
                        style="@style/BookTableAuthText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_account_breadcrumb"
                        android:textColor="@color/booktable_active"
                        android:textSize="@dimen/auth_small_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvForgotTitle"
                        style="@style/BookTableAuthHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_forgot_title"
                        android:textSize="@dimen/auth_forgot_title_text_size" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="@dimen/auth_toolbar_button_size"
                    android:layout_height="@dimen/auth_toolbar_button_size">

                    <ImageButton
                        android:id="@+id/btnForgotNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_auth_white_rounded"
                        android:contentDescription="@string/auth_notifications"
                        android:src="@drawable/ic_auth_bell"
                        app:tint="@color/booktable_dark" />

                    <View
                        android:layout_width="@dimen/auth_notification_dot_size"
                        android:layout_height="@dimen/auth_notification_dot_size"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="@dimen/auth_notification_dot_margin"
                        android:layout_marginEnd="@dimen/auth_notification_dot_margin"
                        android:background="@drawable/bg_auth_notification_dot" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/flForgotIcon"
                android:layout_width="@dimen/auth_forgot_icon_container_size"
                android:layout_height="@dimen/auth_forgot_icon_container_size"
                android:layout_marginTop="@dimen/auth_forgot_icon_margin_top"
                android:background="@drawable/bg_auth_icon_surface">

                <ImageView
                    android:id="@+id/ivForgotEmail"
                    android:layout_width="@dimen/auth_forgot_icon_size"
                    android:layout_height="@dimen/auth_forgot_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_auth_email"
                    app:tint="@color/booktable_active" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvForgotDescription"
                style="@style/BookTableAuthText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_forgot_description_margin_top"
                android:text="@string/auth_reset_description"
                android:textColor="@color/booktable_muted"
                android:textSize="@dimen/auth_description_text_size" />

            <TextView
                android:id="@+id/tvForgotEmailLabel"
                style="@style/BookTableAuthLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_group_margin_top"
                android:text="@string/auth_email_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_field_height"
                android:layout_marginTop="@dimen/auth_field_margin_top"
                app:boxBackgroundColor="@color/auth_input_background"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/auth_card_radius"
                app:boxCornerRadiusBottomStart="@dimen/auth_card_radius"
                app:boxCornerRadiusTopEnd="@dimen/auth_card_radius"
                app:boxCornerRadiusTopStart="@dimen/auth_card_radius"
                app:boxStrokeColor="@color/booktable_border"
                app:boxStrokeWidth="@dimen/nav_bottom_stroke_width"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_auth_email"
                app:startIconTint="@color/booktable_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etForgotEmail"
                    style="@style/BookTableAuthText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/auth_email_hint"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:textColor="@color/booktable_dark"
                    android:textColorHint="@color/booktable_muted"
                    android:textSize="@dimen/auth_body_text_size" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvForgotHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_forgot_note_margin_top"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/auth_card_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/booktable_border"
                app:strokeWidth="@dimen/nav_bottom_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/auth_forgot_note_padding">

                    <TextView
                        android:id="@+id/tvForgotHintTitle"
                        style="@style/BookTableAuthLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_check_email_title" />

                    <TextView
                        android:id="@+id/tvForgotHintBody"
                        style="@style/BookTableAuthText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_field_margin_top"
                        android:text="@string/auth_check_email_body"
                        android:textColor="@color/booktable_muted"
                        android:textSize="@dimen/auth_body_text_size" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/llForgotActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingBottom="@dimen/auth_action_panel_bottom_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/vForgotPanelDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_bottom_stroke_width"
            android:background="@color/booktable_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendReset"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_button_height"
            android:layout_marginStart="@dimen/auth_action_panel_padding"
            android:layout_marginTop="@dimen/auth_field_margin_top"
            android:layout_marginEnd="@dimen/auth_action_panel_padding"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/auth_send_reset"
            android:textColor="@color/white"
            android:textSize="@dimen/auth_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/booktable_orange"
            app:cornerRadius="@dimen/auth_button_radius" />

        <TextView
            android:id="@+id/tvForgotBackToLogin"
            style="@style/BookTableAuthText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/auth_reset_bottom_link_margin_top"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="@dimen/auth_horizontal_gap"
            android:paddingBottom="@dimen/auth_horizontal_gap"
            android:text="@string/auth_back_to_login"
            android:textColor="@color/booktable_active"
            android:textSize="@dimen/auth_body_text_size"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
