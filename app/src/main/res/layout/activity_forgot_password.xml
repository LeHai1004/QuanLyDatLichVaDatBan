<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forgotPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvForgotPassword"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/llForgotActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_forgot_padding_horizontal"
            android:paddingTop="@dimen/auth_screen_padding_top"
            android:paddingEnd="@dimen/auth_forgot_padding_horizontal"
            android:paddingBottom="@dimen/auth_forgot_content_padding_bottom">

            <!-- Page header -->
            <LinearLayout
                android:id="@+id/llForgotToolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_forgot_toolbar_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnForgotBack"
                    android:layout_width="@dimen/auth_forgot_back_size"
                    android:layout_height="@dimen/auth_forgot_back_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_back_to_login"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_auth_back"
                    app:tint="@color/booktable_dark" />

                <LinearLayout
                    android:id="@+id/llForgotHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/auth_brand_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/auth_forgot_emblem_size"
                            android:layout_height="@dimen/auth_forgot_emblem_size"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_splash_logo" />

                        <TextView
                            android:id="@+id/tvForgotBreadcrumb"
                            style="@style/BookTableAuthText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/auth_brand_inset"
                            android:text="@string/auth_account_breadcrumb"
                            android:textColor="@color/booktable_active"
                            android:textSize="@dimen/auth_forgot_breadcrumb_text_size"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvForgotTitle"
                        style="@style/BookTableAuthHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_forgot_heading_gap"
                        android:text="@string/auth_forgot_title"
                        android:textSize="@dimen/auth_forgot_title_text_size" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnForgotNotifications"
                    android:layout_width="@dimen/auth_forgot_bell_size"
                    android:layout_height="@dimen/auth_forgot_bell_size"
                    android:background="@drawable/bg_auth_white_rounded"
                    android:contentDescription="@string/auth_notifications"
                    android:padding="@dimen/nav_bottom_padding"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_auth_bell"
                    app:tint="@color/booktable_dark" />
            </LinearLayout>

            <!-- Recovery introduction -->
            <FrameLayout
                android:id="@+id/flForgotIcon"
                android:layout_width="@dimen/auth_forgot_icon_container_size"
                android:layout_height="@dimen/auth_forgot_icon_container_size"
                android:layout_marginTop="@dimen/auth_forgot_content_padding_top"
                android:background="@drawable/bg_auth_icon_surface">

                <ImageView
                    android:id="@+id/ivForgotEmail"
                    android:layout_width="@dimen/auth_forgot_icon_size"
                    android:layout_height="@dimen/auth_forgot_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_auth_email"
                    app:tint="@color/booktable_active" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvForgotDescription"
                style="@style/BookTableAuthText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_forgot_intro_gap"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/auth_reset_description"
                android:textColor="@color/booktable_muted"
                android:textSize="@dimen/auth_description_text_size" />

            <!-- Email field -->
            <TextView
                android:id="@+id/tvForgotEmailLabel"
                style="@style/BookTableAuthLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_forgot_content_gap"
                android:text="@string/auth_email_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_label_gap"
                app:boxBackgroundColor="@color/auth_input_background"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="@dimen/auth_field_radius"
                app:boxCornerRadiusBottomStart="@dimen/auth_field_radius"
                app:boxCornerRadiusTopEnd="@dimen/auth_field_radius"
                app:boxCornerRadiusTopStart="@dimen/auth_field_radius"
                app:boxStrokeColor="@color/nav_bottom_border"
                app:boxStrokeWidth="@dimen/nav_bottom_stroke_width"
                app:errorEnabled="true"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_auth_email"
                app:startIconTint="@color/booktable_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etForgotEmail"
                    style="@style/BookTableAuthText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auth_email_hint"
                    android:inputType="textEmailAddress"
                    android:minHeight="@dimen/auth_field_height"
                    android:paddingStart="@dimen/auth_field_padding_horizontal"
                    android:paddingEnd="@dimen/auth_field_padding_horizontal"
                    android:singleLine="true"
                    android:textColor="@color/booktable_dark"
                    android:textColorHint="@color/booktable_muted"
                    android:textSize="@dimen/auth_body_text_size" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Recovery guidance -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvForgotHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_forgot_content_gap"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/auth_forgot_note_radius"
                app:cardElevation="0dp"
                app:strokeColor="@color/nav_bottom_border"
                app:strokeWidth="@dimen/nav_bottom_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/auth_forgot_note_padding">

                    <TextView
                        android:id="@+id/tvForgotHintTitle"
                        style="@style/BookTableAuthLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_check_email_title"
                        android:textSize="@dimen/auth_forgot_note_title_text_size" />

                    <TextView
                        android:id="@+id/tvForgotHintBody"
                        style="@style/BookTableAuthText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/auth_forgot_note_gap"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/auth_check_email_body"
                        android:textColor="@color/booktable_muted"
                        android:textSize="@dimen/auth_forgot_note_body_text_size" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom action -->
    <LinearLayout
        android:id="@+id/llForgotActions"
        android:layout_width="0dp"
        android:layout_height="@dimen/auth_forgot_panel_height"
        android:background="@color/white"
        android:orientation="vertical"
        android:paddingStart="@dimen/auth_forgot_panel_padding_horizontal"
        android:paddingTop="@dimen/auth_forgot_panel_padding_vertical"
        android:paddingEnd="@dimen/auth_forgot_panel_padding_horizontal"
        android:paddingBottom="@dimen/auth_forgot_panel_padding_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendReset"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_forgot_button_height"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/auth_send_reset"
            android:textColor="@color/white"
            android:textSize="@dimen/auth_forgot_button_text_size"
            android:textStyle="bold"
            app:backgroundTint="@color/booktable_orange"
            app:cornerRadius="@dimen/auth_forgot_button_radius" />

        <TextView
            android:id="@+id/tvForgotBackToLogin"
            style="@style/BookTableAuthText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_forgot_return_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/auth_back_to_login"
            android:textColor="@color/booktable_active"
            android:textSize="@dimen/auth_forgot_return_text_size"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
