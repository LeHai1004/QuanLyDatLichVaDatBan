<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llMenuItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_menu_dish_card"
    android:gravity="center_vertical"
    android:minHeight="@dimen/menu_item_height"
    android:orientation="horizontal"
    android:padding="@dimen/menu_item_card_padding">

    <!-- Dish Image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivDish"
        android:layout_width="@dimen/menu_dish_img_size"
        android:layout_height="@dimen/menu_dish_img_size"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_food_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDishName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro"
            android:maxLines="1"
            android:textColor="@color/booktable_dark"
            android:textSize="@dimen/menu_dish_name_size"
            android:textStyle="bold"
            tools:text="Gỏi cuốn tôm thịt" />

        <TextView
            android:id="@+id/tvDishCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro"
            android:maxLines="1"
            android:textColor="@color/booktable_muted"
            android:textSize="@dimen/menu_dish_desc_size"
            tools:text="Khai vị · 4 cuốn / phần" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDishPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_active"
                android:textSize="@dimen/menu_dish_price_size"
                android:textStyle="bold"
                tools:text="69.000đ" />

            <!-- Add / Quantity Controls -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- When 0 quantity: single Add button -->
                <LinearLayout
                    android:id="@+id/btnAddDish"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/menu_btn_add_height"
                    android:background="@drawable/bg_menu_add_btn_empty"
                    android:gravity="center"
                    android:minWidth="@dimen/menu_btn_add_min_width"
                    android:orientation="horizontal"
                    android:paddingHorizontal="7dp">

                    <ImageView
                        android:layout_width="@dimen/menu_btn_add_icon_size"
                        android:layout_height="@dimen/menu_btn_add_icon_size"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/booktable_orange" />
                </LinearLayout>

                <!-- When > 0 quantity: Stepper (- count +) -->
                <LinearLayout
                    android:id="@+id/llQuantityControl"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/menu_btn_add_height"
                    android:background="@drawable/bg_menu_add_btn_active"
                    android:gravity="center_vertical"
                    android:minWidth="@dimen/menu_btn_add_min_width"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/btnMinus"
                        android:layout_width="@dimen/menu_btn_add_icon_size"
                        android:layout_height="@dimen/menu_btn_add_icon_size"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvQuantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/white"
                        android:textSize="@dimen/menu_btn_add_text_size"
                        android:textStyle="bold"
                        tools:text="2" />

                    <ImageView
                        android:id="@+id/btnPlus"
                        android:layout_width="@dimen/menu_btn_add_icon_size"
                        android:layout_height="@dimen/menu_btn_add_icon_size"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/white" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
