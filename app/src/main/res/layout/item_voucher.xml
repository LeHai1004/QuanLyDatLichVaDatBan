<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVoucher"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/voucher_card_bg"
    app:cardCornerRadius="@dimen/voucher_card_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/voucher_card_padding">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/voucher_icon_size"
            android:layout_height="@dimen/voucher_icon_size"
            android:contentDescription="@string/voucher_title"
            android:src="@drawable/ic_voucher_ticket" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_voucher_tag"
                android:fontFamily="@font/be_vietnam_pro"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/booktable_orange"
                android:textSize="@dimen/auth_label_text_size"
                android:textStyle="bold"
                tools:text="BEP20K" />

            <TextView
                android:id="@+id/tvValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_dark"
                android:textSize="@dimen/auth_button_text_size"
                android:textStyle="bold"
                tools:text="Giảm 20.000đ" />

            <TextView
                android:id="@+id/tvCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_muted"
                android:textSize="@dimen/auth_label_text_size"
                tools:text="Đơn từ 200.000đ" />

            <TextView
                android:id="@+id/tvExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_muted"
                android:textSize="@dimen/auth_footer_text_size"
                tools:text="HSD: 30/11/2026" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseVoucher"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/voucher_btn_height"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/voucher_btn_use_now"
            android:textColor="@color/booktable_surface"
            android:textSize="@dimen/auth_label_text_size"
            app:backgroundTint="@color/booktable_orange"
            app:cornerRadius="@dimen/voucher_btn_radius" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
