<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOwnerMenuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/owner_menu_title"
                android:textColor="@color/booktable_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOwnerMenuSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/owner_menu_subtitle"
                android:textColor="@color/booktable_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddDish"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="@color/booktable_orange"
            android:fontFamily="@font/be_vietnam_pro"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/owner_menu_add_dish"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="21dp"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart"
            app:iconSize="16dp"
            app:iconTint="@color/white" />
    </LinearLayout>

    <!-- Categories Filter Chips -->
    <HorizontalScrollView
        android:id="@+id/hsvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgCategories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- 3 States: Loading, Empty, Error -->
    <include
        android:id="@+id/layoutStates"
        layout="@layout/layout_shared_states"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Recycler View for Menu Items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOwnerMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="80dp"
        tools:listitem="@layout/item_owner_menu" />

</LinearLayout>
