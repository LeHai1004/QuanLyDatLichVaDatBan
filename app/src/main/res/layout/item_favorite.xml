<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardFavorite"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner + Floating Heart Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/ivRestaurantBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/placeholder_image_bg"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_restaurant_placeholder" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_detail_banner_overlay" />

            <!-- Floating Heart Button -->
            <ImageView
                android:id="@+id/ivHeart"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_heart_filled" />

            <!-- Status Badge (Mở / Đóng) -->
            <TextView
                android:id="@+id/tvRestaurantStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_status_badge_open"
                android:fontFamily="@font/be_vietnam_pro"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/auth_success"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Đang mở cửa" />
        </FrameLayout>

        <!-- Restaurant Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Name & Category -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRestaurantName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:maxLines="1"
                    android:textColor="@color/booktable_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Nhà hàng Bếp Xưa" />

                <!-- Rating -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_star"
                        app:tint="@color/star_gold" />

                    <TextView
                        android:id="@+id/tvRestaurantRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/booktable_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="4.8" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvRestaurantCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_orange"
                android:textSize="12sp"
                tools:text="Món Việt · Lẩu &amp; Nướng" />

            <!-- Address & Hours -->
            <TextView
                android:id="@+id/tvRestaurantAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro"
                android:maxLines="1"
                android:textColor="@color/booktable_muted"
                android:textSize="12sp"
                tools:text="123 Nguyễn Văn Cừ, Quận 5, TP.HCM" />

            <TextView
                android:id="@+id/tvRestaurantHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_muted"
                android:textSize="12sp"
                tools:text="Giờ mở cửa: 09:00 - 22:00" />

            <!-- Bottom row: Deposit & Book Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="Tiền cọc giữ chỗ"
                        android:textColor="@color/booktable_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvRestaurantDeposit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/booktable_orange"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="100.000 đ" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBookNow"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/booktable_orange"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Đặt bàn"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:cornerRadius="19dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
