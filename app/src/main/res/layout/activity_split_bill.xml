<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_booking_back_btn"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_auth_back"
            app:tint="@color/booktable_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:text="@string/split_bill_title"
            android:textColor="@color/booktable_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Mode Switcher Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_owner_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <LinearLayout
                    android:id="@+id/llTabEqual"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_owner_payment_method_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivIconEqual"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_split_equal"
                        app:tint="@color/booktable_orange" />

                    <TextView
                        android:id="@+id/tvTabEqual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/split_bill_mode_equal"
                        android:textColor="@color/booktable_orange"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llTabItems"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivIconItems"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_split_items"
                        app:tint="@color/booktable_muted" />

                    <TextView
                        android:id="@+id/tvTabItems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/split_bill_mode_items"
                        android:textColor="@color/booktable_muted"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Overview Card: Total Payable + Paid Progress -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/booktable_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/split_bill_total_payable"
                        android:textColor="@color/booktable_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalPayable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/booktable_orange"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="250.000 đ" />

                    <TextView
                        android:id="@+id/tvPaidProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/booktable_dark"
                        android:textSize="13sp"
                        tools:text="Đã thanh toán: 0/2 người" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 1: Equal Split Guest Selector & Remainder Banner -->
            <LinearLayout
                android:id="@+id/llModeEqualContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/split_bill_guest_count_label"
                        android:textColor="@color/booktable_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Counter [-] N [+] -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_owner_input_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <ImageView
                            android:id="@+id/btnMinusGuest"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_booking_back_btn"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_minus"
                            app:tint="@color/booktable_dark" />

                        <TextView
                            android:id="@+id/tvGuestCount"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:gravity="center"
                            android:textColor="@color/booktable_dark"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="2 người" />

                        <ImageView
                            android:id="@+id/btnPlusGuest"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_booking_back_btn"
                            android:clickable="true"
                            android:contentDescription="@null"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/booktable_dark" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Remainder Notice -->
                <LinearLayout
                    android:id="@+id/llRemainderNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_owner_stat_today"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_split_round_notice" />

                    <TextView
                        android:id="@+id/tvRemainderNotice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/booktable_orange"
                        android:textSize="12sp"
                        tools:text="Do chia tiền lẻ không tròn, người đầu tiên (chủ bàn) trả thêm 1 đ tiền làm tròn." />
                </LinearLayout>
            </LinearLayout>

            <!-- Mode 2: Items Split Section -->
            <LinearLayout
                android:id="@+id/llModeItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/split_bill_dishes_section_title"
                    android:textColor="@color/booktable_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOrderItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_split_dish" />

                <TextView
                    android:id="@+id/tvItemAssignError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:textColor="@color/booktable_error"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Món 'Phở bò' chưa được gán cho ai."
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Persons List Heading -->
            <TextView
                android:id="@+id/tvPersonsListHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Danh sách người chia"
                android:textColor="@color/booktable_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Persons RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPersons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_split_person" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Finish Action Bar -->
    <LinearLayout
        android:id="@+id/llBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishSplit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/split_bill_btn_finish"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/booktable_orange"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
