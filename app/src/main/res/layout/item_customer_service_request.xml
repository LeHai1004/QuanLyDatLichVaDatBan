<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/booktable_dark"
            android:textSize="@dimen/auth_body_text_size"
            android:textStyle="bold"
            tools:text="Xin nước" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/be_vietnam_pro"
            android:textColor="@color/booktable_muted"
            android:textSize="@dimen/auth_label_text_size"
            tools:text="Vừa xong" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_badge_open"
        android:fontFamily="@font/be_vietnam_pro"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/booktable_orange"
        android:textSize="@dimen/auth_label_text_size"
        tools:text="Đã gửi, vui lòng chờ" />
</LinearLayout>
