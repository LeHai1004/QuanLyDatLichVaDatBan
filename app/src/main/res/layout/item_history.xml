<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/history_card_radius"
    app:cardElevation="@dimen/history_card_elevation"
    app:strokeColor="@color/booktable_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Restaurant Name & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRestaurantName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/booktable_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Nhà hàng Cua Vàng" />

            <TextView
                android:id="@+id/tvBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_history_status_confirmed"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/history_status_confirmed_text"
                android:textSize="12sp"
                tools:text="Đã xác nhận" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/booktable_border" />

        <!-- Info details -->
        <!-- Row 1: Date & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_history_calendar"
                app:tint="@color/booktable_orange" />

            <TextView
                android:id="@+id/tvBookingDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/booktable_dark"
                android:textSize="14sp"
                tools:text="20/11/2026 · 19:30" />
        </LinearLayout>

        <!-- Row 2: Guests & Table -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_history_users"
                app:tint="@color/booktable_muted" />

            <TextView
                android:id="@+id/tvBookingGuests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/booktable_muted"
                android:textSize="13sp"
                tools:text="4 khách" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:text="·"
                android:textColor="@color/booktable_muted" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/booktable_muted" />

            <TextView
                android:id="@+id/tvBookingTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/booktable_muted"
                android:textSize="13sp"
                tools:text="Bàn T1-04 (Tầng 1)" />
        </LinearLayout>

        <!-- Row 3: Deposit amount -->
        <TextView
            android:id="@+id/tvDepositAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/booktable_muted"
            android:textSize="13sp"
            tools:text="Tiền cọc: 100.000đ" />

        <!-- Actions Container -->
        <LinearLayout
            android:id="@+id/llActionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- Upcoming actions (Đổi lịch + Hủy bàn) -->
            <LinearLayout
                android:id="@+id/llUpcomingActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnChangeSchedule"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/history_action_btn_height"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_history_action_outlined"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/history_btn_change_schedule"
                    android:textAllCaps="false"
                    android:textColor="@color/booktable_orange"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCancelBooking"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/history_action_btn_height"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_history_cancel_outlined"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/history_btn_cancel_booking"
                    android:textAllCaps="false"
                    android:textColor="@color/booktable_error"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Review Action (PAID status) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReview"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_action_btn_height"
                android:background="@drawable/bg_button_orange"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="6dp"
                android:drawableTint="@color/white"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/history_btn_review_now"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="gone" />

            <!-- Reorder Action (COMPLETED or CANCELLED) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReorder"
                android:layout_width="match_parent"
                android:layout_height="@dimen/history_action_btn_height"
                android:background="@drawable/bg_btn_history_action_outlined"
                android:fontFamily="sans-serif-medium"
                android:text="@string/history_btn_reorder"
                android:textAllCaps="false"
                android:textColor="@color/booktable_orange"
                android:textSize="13sp"
                android:visibility="gone"
                tools:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
