<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llBookingListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/owner_booking_topbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/cd_back_button"
            android:src="@drawable/ic_auth_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/owner_booking_list_title"
            android:textColor="@color/booktable_dark"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnScanQr"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Quét vé QR"
            android:src="@drawable/ic_owner_table_qr"
            app:tint="@color/booktable_orange" />

        <ImageView
            android:id="@+id/btnFilterOptions"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:contentDescription="@string/cd_filter_options"
            android:src="@drawable/ic_sliders_horizontal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/payment_card_border" />

    <!-- Date Filter Dropdown / Picker row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:id="@+id/llDateFilter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/owner_booking_filter_height"
            android:background="@drawable/bg_date_filter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/owner_booking_arrival_time_label"
                android:src="@drawable/ic_nav_calendar"
                app:tint="@color/booktable_dark" />

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Hôm nay, 18/10/2026" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/owner_booking_arrival_time_label"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>

        <!-- Status Tabs: Chờ duyệt | Đã xác nhận | Đã đến | Đã hủy -->
        <LinearLayout
            android:id="@+id/llStatusTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Tab 0: Chờ duyệt -->
            <LinearLayout
                android:id="@+id/tabWaiting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabWaiting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/owner_booking_tab_waiting"
                    android:textColor="@color/booktable_active"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/vTabUnderlineWaiting"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/booktable_orange" />
            </LinearLayout>

            <!-- Tab 1: Đã xác nhận -->
            <LinearLayout
                android:id="@+id/tabConfirmed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabConfirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/owner_booking_tab_confirmed"
                    android:textColor="@color/booktable_muted"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/vTabUnderlineConfirmed"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/owner_booking_tab_unselected" />
            </LinearLayout>

            <!-- Tab 2: Đã đến -->
            <LinearLayout
                android:id="@+id/tabArrived"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabArrived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/owner_booking_tab_arrived"
                    android:textColor="@color/booktable_muted"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/vTabUnderlineArrived"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/owner_booking_tab_unselected" />
            </LinearLayout>

            <!-- Tab 3: Đã hủy -->
            <LinearLayout
                android:id="@+id/tabCancelled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTabCancelled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/owner_booking_tab_cancelled"
                    android:textColor="@color/booktable_muted"
                    android:textSize="11sp" />

                <View
                    android:id="@+id/vTabUnderlineCancelled"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/owner_booking_tab_unselected" />
            </LinearLayout>
        </LinearLayout>

        <!-- Queue Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvQueueSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro"
                android:textColor="@color/booktable_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="3 lượt đang chờ duyệt" />

            <TextView
                android:id="@+id/tvSortLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="@string/owner_booking_sort_earliest"
                android:textColor="@color/booktable_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- State View for Loading / Error / Empty -->
    <include
        android:id="@+id/layoutStates"
        layout="@layout/layout_shared_states"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- RecyclerView for Bookings -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp" />
</LinearLayout>
