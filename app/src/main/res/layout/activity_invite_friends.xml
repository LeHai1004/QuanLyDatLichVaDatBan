<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booktable_cream"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/llToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_booking_back_btn"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_auth_back"
            app:tint="@color/booktable_dark" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro"
            android:gravity="center"
            android:text="@string/invite_friends_title"
            android:textColor="@color/booktable_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="32dp">

            <!-- Card 1: Invite Code & Share Actions -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/booktable_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:text="@string/invite_friends_code_label"
                        android:textColor="@color/booktable_muted"
                        android:textSize="13sp" />

                    <!-- Big Invite Code Banner -->
                    <TextView
                        android:id="@+id/tvInviteCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_owner_input_field"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:letterSpacing="0.05"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/booktable_orange"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="INVITE-BT123456" />

                    <!-- 2 Buttons: Copy Code & Share Invite -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyCode"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/invite_friends_btn_copy"
                            android:textAllCaps="false"
                            android:textColor="@color/booktable_orange"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/booktable_surface"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_invite_copy"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconTint="@color/booktable_orange"
                            app:strokeColor="@color/booktable_orange"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShareInvite"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/invite_friends_btn_share"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/booktable_orange"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_invite_share"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Booking Info Summary -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/booktable_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvRestaurantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/booktable_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Nhà hàng Hương Biển" />

                    <TextView
                        android:id="@+id/tvBookingDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/be_vietnam_pro"
                        android:textColor="@color/booktable_muted"
                        android:textSize="13sp"
                        tools:text="19:00 · Thứ 7, 20/11/2026" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBookingTable"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:textColor="@color/booktable_dark"
                            android:textSize="13sp"
                            tools:text="Bàn: T2-04 (Tầng 2)" />

                        <TextView
                            android:id="@+id/tvBookingGuestsLimit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro"
                            android:textColor="@color/booktable_orange"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Tối đa: 4 khách" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Row: Enter other code & Add my dishes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnterInviteCode"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/invite_friends_btn_enter_code"
                    android:textAllCaps="false"
                    android:textColor="@color/booktable_dark"
                    android:textSize="12sp"
                    app:backgroundTint="@color/booktable_surface"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/booktable_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddMyDishes"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/invite_friends_btn_add_my_dishes"
                    android:textAllCaps="false"
                    android:textColor="@color/booktable_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/booktable_surface"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_invite_add_dish"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconTint="@color/booktable_orange"
                    app:strokeColor="@color/booktable_orange"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Section Heading: Participants List -->
            <TextView
                android:id="@+id/tvParticipantsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/be_vietnam_pro"
                android:text="Những người tham gia (1/4)"
                android:textColor="@color/booktable_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Participants RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGuests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_guest" />

            <!-- Loading State -->
            <LinearLayout
                android:id="@+id/llLoadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/booktable_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/be_vietnam_pro"
                    android:text="@string/state_loading"
                    android:textColor="@color/booktable_muted"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
