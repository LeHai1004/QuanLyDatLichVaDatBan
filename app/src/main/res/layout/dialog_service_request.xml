<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llServiceRequestRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_filter_chip" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro"
        android:text="@string/service_request_title"
        android:textColor="@color/booktable_dark"
        android:textSize="@dimen/detail_section_title_size"
        android:textStyle="bold" />

    <!-- Request Buttons Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestCall"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/service_request_btn_call_staff"
            android:textColor="@color/booktable_orange"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/booktable_orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestWater"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/service_request_btn_water"
            android:textColor="@color/booktable_orange"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/booktable_orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestBill"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/be_vietnam_pro"
            android:text="@string/service_request_btn_bill"
            android:textColor="@color/booktable_orange"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/booktable_orange" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/booktable_border" />

    <!-- Sent Requests Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/be_vietnam_pro"
        android:text="Lịch sử yêu cầu đã gửi"
        android:textColor="@color/booktable_dark"
        android:textSize="@dimen/auth_body_text_size"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomerRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:listitem="@layout/item_customer_service_request" />

</LinearLayout>
