<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/customerHomeFragment">

    <!-- Customer fragments -->
    <fragment
        android:id="@+id/customerHomeFragment"
        android:name="com.ute.quanlydatban.ui.customer.HomeFragment"
        android:label="@string/nav_home">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_home" />
        <action
            android:id="@+id/action_customerHomeFragment_to_searchFilterFragment"
            app:destination="@id/searchFilterFragment" />
        <action
            android:id="@+id/action_customerHomeFragment_to_customerNotificationFragment"
            app:destination="@id/customerNotificationFragment" />
    </fragment>

    <fragment
        android:id="@+id/customerNotificationFragment"
        android:name="com.ute.quanlydatban.ui.customer.NotificationFragment"
        android:label="@string/customer_notification_title" />

    <fragment
        android:id="@+id/customerBookingFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/nav_booking">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_booking" />
    </fragment>

    <fragment
        android:id="@+id/customerHistoryFragment"
        android:name="com.ute.quanlydatban.ui.customer.history.HistoryFragment"
        android:label="@string/nav_history">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_history" />
    </fragment>

    <fragment
        android:id="@+id/customerProfileFragment"
        android:name="com.ute.quanlydatban.ui.customer.profile.ProfileFragment"
        android:label="@string/nav_profile">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_profile" />
    </fragment>

    <fragment
        android:id="@+id/searchFilterFragment"
        android:name="com.ute.quanlydatban.ui.customer.SearchFilterFragment"
        android:label="@string/search_filter_title" />

    <!-- Owner fragments -->
    <fragment
        android:id="@+id/ownerOverviewFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerDashboardFragment"
        android:label="@string/nav_owner_overview">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_owner_overview" />
        <action
            android:id="@+id/action_ownerOverviewFragment_to_ownerNotificationFragment"
            app:destination="@id/ownerNotificationFragment" />
        <action
            android:id="@+id/action_ownerOverviewFragment_to_ownerReviewFragment"
            app:destination="@id/ownerReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/ownerBookingFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerBookingListFragment"
        android:label="@string/nav_owner_orders">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_owner_orders" />
        <action
            android:id="@+id/action_ownerBookingListFragment_to_ownerPreOrderFragment"
            app:destination="@id/ownerPreOrderFragment" />
    </fragment>

    <fragment
        android:id="@+id/ownerHistoryFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerStatsFragment"
        android:label="@string/nav_history">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_history" />
    </fragment>

    <fragment
        android:id="@+id/ownerProfileFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerProfileFragment"
        android:label="@string/nav_profile">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_profile" />
        <action
            android:id="@+id/action_ownerProfileFragment_to_ownerReviewFragment"
            app:destination="@id/ownerReviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/ownerNotificationFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerNotificationFragment"
        android:label="@string/owner_notification_title" />

    <!-- Customer Booking Flow (T9) -->
    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.ute.quanlydatban.ui.customer.booking.BookingFragment"
        android:label="@string/booking_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/booking_title" />
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_bookingFragment_to_tableSelectFragment"
            app:destination="@id/tableSelectFragment" />
    </fragment>

    <fragment
        android:id="@+id/tableSelectFragment"
        android:name="com.ute.quanlydatban.ui.customer.booking.TableSelectFragment"
        android:label="@string/table_select_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/table_select_title" />
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_tableSelectFragment_to_menuFragment"
            app:destination="@id/menuFragment" />
    </fragment>

    <!-- Menu & Cart Flow (T10) -->
    <fragment
        android:id="@+id/menuFragment"
        android:name="com.ute.quanlydatban.ui.customer.menu.MenuFragment"
        android:label="@string/menu_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/menu_title" />
        <argument
            android:name="bookingId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_menuFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
        <action
            android:id="@+id/action_menuFragment_to_paymentPlaceholderFragment"
            app:destination="@id/paymentPlaceholderFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.ute.quanlydatban.ui.customer.menu.CartFragment"
        android:label="@string/cart_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/cart_title" />
        <argument
            android:name="bookingId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_cartFragment_to_paymentPlaceholderFragment"
            app:destination="@id/paymentPlaceholderFragment" />
    </fragment>

    <!-- Destination tạm cho Payment T11 -->
    <fragment
        android:id="@+id/paymentPlaceholderFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/payment_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/payment_title" />
        <argument
            android:name="bookingId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Owner PreOrder (T14) -->
    <fragment
        android:id="@+id/ownerPreOrderFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerPreOrderFragment"
        android:label="@string/owner_preorder_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/owner_preorder_title" />
    </fragment>

    <!-- Owner Table Map (T21) -->
    <fragment
        android:id="@+id/ownerTablePlaceholderFragment"
        android:name="com.ute.quanlydatban.ui.owner.table.OwnerTableMapFragment"
        android:label="@string/nav_owner_table">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/nav_owner_table" />
    </fragment>

    <!-- Owner Menu Placeholder (T13) -->
    <fragment
        android:id="@+id/ownerMenuPlaceholderFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/nav_owner_menu">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/nav_owner_menu" />
    </fragment>

    <!-- Voucher Customer (T24) -->
    <fragment
        android:id="@+id/voucherFragment"
        android:name="com.ute.quanlydatban.ui.customer.voucher.VoucherFragment"
        android:label="@string/voucher_title">
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="totalBill"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <!-- Voucher Owner (T24) -->
    <fragment
        android:id="@+id/ownerVoucherFragment"
        android:name="com.ute.quanlydatban.ui.owner.voucher.OwnerVoucherFragment"
        android:label="@string/owner_voucher_title">
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Loyalty Placeholder (T25) -->
    <fragment
        android:id="@+id/loyaltyPlaceholderFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/profile_menu_loyalty">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/profile_menu_loyalty" />
    </fragment>

    <!-- Favorite Placeholder (T29) -->
    <fragment
        android:id="@+id/favoritePlaceholderFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/profile_menu_favorites">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/profile_menu_favorites" />
    </fragment>

    <!-- Owner Review (T23) -->
    <fragment
        android:id="@+id/ownerReviewFragment"
        android:name="com.ute.quanlydatban.ui.owner.review.OwnerReviewFragment"
        android:label="@string/owner_review_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/owner_review_title" />
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
</navigation>