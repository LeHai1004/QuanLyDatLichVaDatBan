<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/customerHomeFragment">

    <!-- Customer fragments -->
    <fragment
        android:id="@+id/customerHomeFragment"
        android:name="com.ute.quanlydatban.ui.customer.HomeFragment"
        android:label="@string/nav_home">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_home" />
        <action
            android:id="@+id/action_customerHomeFragment_to_searchFilterFragment"
            app:destination="@id/searchFilterFragment" />
    </fragment>

    <fragment
        android:id="@+id/customerBookingFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/nav_booking">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_booking" />
    </fragment>

    <fragment
        android:id="@+id/customerHistoryFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/nav_history">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_history" />
    </fragment>

    <fragment
        android:id="@+id/customerProfileFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/nav_profile">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_profile" />
    </fragment>

    <fragment
        android:id="@+id/searchFilterFragment"
        android:name="com.ute.quanlydatban.ui.customer.SearchFilterFragment"
        android:label="@string/search_filter_title" />

    <!-- Owner fragments -->
    <fragment
        android:id="@+id/ownerOverviewFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerDashboardFragment"
        android:label="@string/nav_owner_overview">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_owner_overview" />
        <action
            android:id="@+id/action_ownerOverviewFragment_to_ownerNotificationFragment"
            app:destination="@id/ownerNotificationFragment" />
    </fragment>

    <fragment
        android:id="@+id/ownerBookingFragment"
        android:name="com.ute.quanlydatban.ui.common.PlaceholderFragment"
        android:label="@string/nav_owner_orders">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_owner_orders" />
    </fragment>

    <fragment
        android:id="@+id/ownerHistoryFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerStatsFragment"
        android:label="@string/nav_history">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_history" />
    </fragment>

    <fragment
        android:id="@+id/ownerProfileFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerProfileFragment"
        android:label="@string/nav_profile">
        <argument android:name="screenTitle" app:argType="reference" android:defaultValue="@string/nav_profile" />
    </fragment>

    <fragment
        android:id="@+id/ownerNotificationFragment"
        android:name="com.ute.quanlydatban.ui.owner.OwnerNotificationFragment"
        android:label="@string/owner_notification_title" />

    <!-- Customer Booking Flow (T9) -->
    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.ute.quanlydatban.ui.customer.booking.BookingFragment"
        android:label="@string/booking_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/booking_title" />
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_bookingFragment_to_tableSelectFragment"
            app:destination="@id/tableSelectFragment" />
    </fragment>

    <fragment
        android:id="@+id/tableSelectFragment"
        android:name="com.ute.quanlydatban.ui.customer.booking.TableSelectFragment"
        android:label="@string/table_select_title">
        <argument
            android:name="screenTitle"
            app:argType="reference"
            android:defaultValue="@string/table_select_title" />
        <argument
            android:name="restaurantId"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
</navigation>