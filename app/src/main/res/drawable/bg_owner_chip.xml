<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/owner_chip_selected_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/owner_chip_selected_border" />
            <corners android:radius="@dimen/owner_chip_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/booktable_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/booktable_border" />
            <corners android:radius="@dimen/owner_chip_radius" />
        </shape>
    </item>
</selector>
